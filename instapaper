#!/usr/bin/env python3
"""instapaper — thin entrypoint shim.

The real code lives in the instapaper_cli/ package beside this file. This shim
puts that package dir's parent on sys.path (via the resolved real path, so a
symlink onto PATH keeps working) and hands off to instapaper_cli.cli.main.

Zero install: `git pull` is the whole upgrade story. Stdlib only.
"""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))

from instapaper_cli.cli import main

if __name__ == "__main__":
    sys.exit(main())
